{
  "doctype": {
    "type": "!doctype",
    "attributes": {
      "type": "html"
    }
  },
  "html": {
    "type": "html",
    "attributes": {
      "lang": "en"
    },
    "children": [
      {
        "type": "head",
        "children": [
          {
            "type": "meta",
            "attributes": {
              "charset": "UTF-8"
            }
          },
          {
            "type": "meta",
            "attributes": {
              "name": "viewport",
              "content": "width=device-width, initial-scale=1.0"
            }
          },
          {
            "type": "title",
            "children": ["HTML to JSON"]
          },
          {
            "type": "script",
            "attributes": {
              "type": "module",
              "src": "html2json.js",
              "defer": true
            }
          },
          {
            "type": "style",
            "children": [
              {
                "selector": "h1",
                "attributes": {
                  "font-family": "sans-serif"
                }
              },
              {
                "selector": "body",
                "attributes": {
                  "display": "flex",
                  "flex-direction": "column",
                  "align-items": "center"
                }
              },
              {
                "selector": ".container",
                "attributes": {
                  "display": "flex",
                  "width": "100%",
                  "gap": "10px"
                }
              },
              {
                "selector": ".field",
                "attributes": {
                  "display": "flex",
                  "flex-direction": "column",
                  "width": "50%"
                }
              },
              {
                "selector": "textarea",
                "attributes": {
                  "width": "100%",
                  "height": "calc(100vh - 170px)",
                  "max-width": "100%",
                  "white-space": "pre"
                }
              },
              {
                "selector": ".buttons",
                "attributes": {
                  "display": "flex",
                  "gap": "10px",
                  "margin-top": "10px"
                }
              },
              {
                "selector": "button",
                "attributes": {
                  "width": "150px",
                  "height": "40px",
                  "cursor": "pointer"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "body",
        "children": [
          {
            "type": "h1",
            "children": ["Jito's Software Developer Intern \"html2json\" Test Task"]
          },
          {
            "type": "div",
            "attributes": {
              "class": "container"
            },
            "children": [
              {
                "type": "div",
                "attributes": {
                  "class": "field"
                },
                "children": [
                  {
                    "type": "label",
                    "attributes": {
                      "for": "html"
                    },
                    "children": ["Input for \"html2json\" conversion:"]
                  },
                  {
                    "type": "textarea",
                    "attributes": {
                      "id": "html",
                      "placeholder": "Enter your HTML"
                    }
                  }
                ]
              },
              {
                "type": "div",
                "attributes": {
                  "class": "field"
                },
                "children": [
                  {
                    "type": "label",
                    "attributes": {
                      "for": "json"
                    },
                    "children": ["Results of \"html2json\" conversion:"]
                  },
                  {
                    "type": "textarea",
                    "attributes": {
                      "disabled": true,
                      "id": "json",
                      "placeholder": "Here will be output from your html2json function"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "div",
            "attributes": {
              "class": "buttons"
            },
            "children": [
              {
                "type": "button",
                "attributes": {
                  "id": "convert-btn"
                },
                "children": ["Convert to JSON"]
              },
              {
                "type": "button",
                "attributes": {
                  "id": "ex1-btn"
                },
                "children": ["Input Example 1"]
              },
              {
                "type": "button",
                "attributes": {
                  "id": "ex2-btn"
                },
                "children": ["Input Example 2"]
              }
            ]
          }
        ]
      }
    ]
  }
}
